---
// The shell every screen shares: the raymarched gyroid backdrop, the hairline
// frame, and the head metadata. Pages supply only their own words.
interface Props {
  title: string;
  description: string;
  path: string;
  body: string;
  mode?: 'calm' | 'fault';
  negative?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  body,
  mode = 'calm',
  negative = false,
  noindex = false,
} = Astro.props;

// Every Japanese glyph this page can actually paint. Google Fonts' `text`
// parameter returns a subset holding exactly these, which for a page of one
// short line is a few kilobytes instead of the full multi-file family.
const NOSCRIPT =
  '背景はシェーダーで描いているため、JavaScript が無効だと表示されません。文章はそのまま読めます。';
const glyphs = [...new Set((body + NOSCRIPT).replace(/[\u0000-\u00ff]/g, ''))]
  .sort()
  .join('');

// `text` applies to the whole request, so the Latin faces are fetched separately.
const LATIN =
  'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&display=swap';
const JAPANESE =
  'https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400&text=' +
  encodeURIComponent(glyphs) +
  '&display=swap';

const site = Astro.site ?? new URL('https://4sou9.github.io');
const canonical = new URL(path, site).href;
const ogImage = new URL('/og.png', site).href;
---

<html lang="ja" data-negative={negative ? 'on' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content={negative ? 'dark' : 'light'} />
    <meta name="theme-color" content={negative ? '#16161a' : '#eceae4'} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icons/mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/mark-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="4sou9" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="淡い紙の上に、ディザで刷られた格子状の球。" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={LATIN} />
    <link rel="stylesheet" href={JAPANESE} />
    <style is:global>
      :root {
        --paper: #eceae4;
        --ink: #16161a;
        --hair: rgba(22, 22, 26, 0.22);
        --mono: 'IBM Plex Mono', 'Zen Kaku Gothic New', ui-monospace, SFMono-Regular,
          'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif;
        --serif: 'Instrument Serif', 'Times New Roman', ui-serif, serif;
        --pad: clamp(18px, 3.4vw, 52px);
      }

      /* Negative print: the same two tones, traded. */
      :root[data-negative] {
        --paper: #16161a;
        --ink: #eceae4;
        --hair: rgba(236, 234, 228, 0.26);
      }

      * { box-sizing: border-box; }

      html,
      body {
        height: 100%;
        margin: 0;
        overflow: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--mono);
        -webkit-font-smoothing: antialiased;
      }

      body { cursor: crosshair; }

      #stage {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
      }

      /* Fallback ground while the GL context spins up, and if it never does. */
      #stage.dead { display: none; }

      .frame {
        position: fixed;
        inset: var(--pad);
        pointer-events: none;
        display: grid;
        grid-template-rows: 3.4em 1fr 3.4em;
        border-top: 1px solid var(--hair);
        border-bottom: 1px solid var(--hair);
      }

      .lede { align-self: center; }

      .display {
        max-inline-size: 8ch;
        margin: 0;
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(3.4rem, 12.5vw, 12.5rem);
        line-height: 0.86;
        letter-spacing: -0.02em;
        mix-blend-mode: multiply;
      }

      :root[data-negative] .display { mix-blend-mode: screen; }

      /* Dark noise vanishes on a dark ground; flip it so the grain lightens. */
      :root[data-negative] .grain { filter: invert(1); opacity: 0.045; }

      .display em {
        font-style: italic;
        letter-spacing: -0.01em;
      }

      .sub {
        margin: 0;
        margin-block-start: 2.4em;
        max-inline-size: 24em;
        font-size: clamp(11px, 0.9vw, 13px);
        line-height: 1.95;
        letter-spacing: 0.08em;
        opacity: 0.7;
      }

      .noscript {
        position: fixed;
        inset: auto var(--pad) calc(var(--pad) + 3.2em) var(--pad);
        max-width: 24em;
        font-size: 11px;
        letter-spacing: 0.08em;
        opacity: 0.7;
      }

      /* Grain sits above the canvas but below the type. */
      .grain {
        position: fixed;
        inset: -50%;
        pointer-events: none;
        opacity: 0.05;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
        animation: drift 6s steps(4) infinite;
      }

      @keyframes drift {
        0% { transform: translate(0, 0); }
        25% { transform: translate(-3%, 2%); }
        50% { transform: translate(2%, -3%); }
        75% { transform: translate(-2%, -1%); }
        100% { transform: translate(0, 0); }
      }

      @media (prefers-reduced-motion: reduce) {
        .grain { animation: none; }
      }

      @media (max-aspect-ratio: 1/1) {
        .lede { align-self: end; padding-bottom: 0.6em; }
      }

      @media (max-width: 620px) {
        .display { max-inline-size: 7ch; }
      }
    </style>
  </head>

  <body>
    <canvas id="stage" aria-hidden="true" data-mode={mode} data-negative={negative ? 'on' : undefined}></canvas>
    <div class="grain" aria-hidden="true"></div>

    <div class="frame">
      <div class="spacer" aria-hidden="true"></div>
      <div class="lede">
        <slot />
        <p class="sub">{body}</p>
      </div>
      <div class="spacer" aria-hidden="true"></div>
    </div>

    <noscript>
      <p class="noscript">{NOSCRIPT}</p>
    </noscript>

    <script is:inline>
      (() => {
        const canvas = document.getElementById('stage');
        const fault = canvas.dataset.mode === 'fault' ? 1 : 0;
        const neg = canvas.dataset.negative ? 1 : 0;
        const gl = canvas.getContext('webgl2', {
          antialias: false,
          alpha: false,
          powerPreference: 'high-performance',
        });

        if (!gl) {
          canvas.classList.add('dead');
          return;
        }

        const VERT = `#version 300 es
        precision highp float;
        const vec2 P[3] = vec2[3](vec2(-1.,-1.), vec2(3.,-1.), vec2(-1.,3.));
        void main(){ gl_Position = vec4(P[gl_VertexID], 0., 1.); }`;

        const FRAG = `#version 300 es
        precision highp float;
        out vec4 O;

        uniform vec2  uRes;    // drawing buffer size in px
        uniform float uTime;   // seconds
        uniform vec2  uMouse;  // -1..1, smoothed
        uniform float uPix;    // dither cell size in px
        uniform float uSteps;  // march budget
        uniform vec2  uShift;  // where the object sits, in uv units
        uniform float uZoom;   // >1 pulls the object away
        uniform float uFault;  // 0 = intact, 1 = the lattice comes apart
        uniform float uNeg;    // 1 = negative print, paper and ink traded

        mat2 rot(float a){ float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }

        // Pseudo-distance to a gyroid shell of thickness t at frequency s.
        float gyroid(vec3 p, float s, float t){
          p *= s;
          return abs(dot(sin(p), cos(p.zxy))) / s - t;
        }

        // Hollow sphere carved out of a layered gyroid lattice.
        float map(vec3 p){
          vec3 q = p;
          // The cursor turns the lattice itself, not only the camera, so the
          // shape reads as something handled rather than orbited.
          q.xz *= rot(uTime * 0.075 + uMouse.x * 1.15);
          q.xy *= rot(uTime * 0.048 - uMouse.y * 0.75);

          // Fault mode shears the field into slabs, so the sphere reads as
          // something that has come apart along horizontal planes.
          if (uFault > 0.) {
            float slab = floor(p.y * 4.5 + uTime * 0.35);
            float jog = fract(sin(slab * 91.7) * 4183.7) - 0.5;
            q.xz += jog * 0.5 * uFault;
            q.y += jog * 0.06 * uFault;
          }

          float shell = length(p) - 1.02;
          float g  = gyroid(q, 5.6, 0.021);
          float g2 = gyroid(q + 1.7, 13.2, 0.012);
          float g3 = gyroid(q - 4.2, 31.0, 0.006);

          g -= g2 * 0.055;
          g += g3 * 0.02;

          float d = max(shell, g);
          d = max(d, -(length(p) - 0.58));   // hollow the core
          return d * 0.5;                    // Lipschitz safety
        }

        vec3 normal(vec3 p){
          vec2 e = vec2(0.0016, 0.);
          return normalize(vec3(
            map(p + e.xyy) - map(p - e.xyy),
            map(p + e.yxy) - map(p - e.yxy),
            map(p + e.yyx) - map(p - e.yyx)
          ));
        }

        // Bayer 8x8 threshold, 0..63, built from interleaved bit pairs.
        float bayer(uvec2 c){
          uint x = (c.x ^ c.y) & 7u;
          uint y = c.y & 7u;
          uint v = 0u;
          for (int i = 2; i >= 0; i--) {
            uint b = uint(i);
            v = (v << 2u) | (((x >> b) & 1u) << 1u) | ((y >> b) & 1u);
          }
          return float(v);
        }

        float hash(vec2 p){
          return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
        }

        void main(){
          vec2 uv = (gl_FragCoord.xy * 2. - uRes) / uRes.y;
          uv = uv * uZoom - uShift;

          vec3 ro = vec3(uMouse.x * 0.72, uMouse.y * 0.52, 3.95);
          vec3 ta = vec3(uMouse.x * -0.11, uMouse.y * -0.08, 0.);
          vec3 fw = normalize(ta - ro);
          vec3 rt = normalize(cross(vec3(0., 1., 0.), fw));
          vec3 up = cross(fw, rt);
          vec3 rd = normalize(uv.x * rt + uv.y * up + 1.55 * fw);

          float t = 0.;
          float hit = 0.;
          float wander = 0.;
          int budget = int(uSteps);

          for (int i = 0; i < 96; i++) {
            if (i >= budget) break;
            vec3 p = ro + rd * t;
            float d = map(p);
            if (d < 0.0012) { hit = 1.; break; }
            if (t > 6.) break;
            t += d;
            wander += 1.;
          }

          // Paper is left flat so the dither has nothing to chew on.
          float lum = 1.;

          if (hit > 0.5) {
            vec3 p = ro + rd * t;
            vec3 n = normal(p);
            vec3 l = normalize(vec3(0.55, 0.82, 0.42));

            float diff = clamp(dot(n, l), 0., 1.);
            float wrap = clamp(dot(n, l) * 0.5 + 0.5, 0., 1.);
            float fres = pow(1. - clamp(dot(n, -rd), 0., 1.), 3.5);
            float ao   = clamp(1. - wander / float(budget) * 1.35, 0., 1.);

            float ink = 0.05 + diff * 0.40 + wrap * 0.14 + fres * 0.46;
            ink *= mix(0.42, 1., ao);
            lum = clamp(ink, 0., 1.);
          }

          // Distance haze so the far side of the lattice fades into the paper.
          lum = mix(lum, 1., smoothstep(3.0, 5.6, t) * hit);

          // Ordered dither into five ink tones, on a chunky pixel grid.
          vec2 cell = floor(gl_FragCoord.xy / uPix);
          float th = (bayer(uvec2(cell)) + 0.5) / 64. - 0.5;
          // Grain only where there is ink; the paper stays clean.
          float grain = (hash(cell + uTime * 0.0007) - 0.5) * 0.05
                      * smoothstep(1., 0.86, lum);
          float LEVELS = mix(4., 2., uFault);
          float q = clamp(floor((lum + grain) * LEVELS + th + 0.5) / LEVELS, 0., 1.);

          // Wash and vignette land after quantisation, so they never band.
          vec2 v = (gl_FragCoord.xy * 2. - uRes) / uRes.y;
          float wash = 1. - dot(v, v) * 0.018 - v.y * 0.012;

          // The quantised tone is placed between a ground and a highlight,
          // which is the one spot the negative needs: trade the two ends.
          float tone = mix(q, 1. - q, uNeg);
          vec3 lo = mix(vec3(0.), vec3(0.055, 0.055, 0.066), uNeg);
          vec3 hi = mix(vec3(0.985, 0.98, 0.96), vec3(0.93, 0.925, 0.90), uNeg);
          O = vec4(mix(lo, hi, tone) * wash, 1.);
        }`;

        const compile = (type, src) => {
          const sh = gl.createShader(type);
          gl.shaderSource(sh, src.replace(/^\s+/gm, ''));
          gl.compileShader(sh);
          if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
            console.error(gl.getShaderInfoLog(sh));
            return null;
          }
          return sh;
        };

        // Every GL object dies with the context, so building them is a step we
        // can repeat: once at startup, and again after a context is restored.
        let u = null;

        const build = () => {
          const vs = compile(gl.VERTEX_SHADER, VERT);
          const fs = compile(gl.FRAGMENT_SHADER, FRAG);
          if (!vs || !fs) return false;

          const prog = gl.createProgram();
          gl.attachShader(prog, vs);
          gl.attachShader(prog, fs);
          gl.linkProgram(prog);
          if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
            console.error(gl.getProgramInfoLog(prog));
            return false;
          }
          gl.useProgram(prog);
          gl.bindVertexArray(gl.createVertexArray());

          u = {
            res: gl.getUniformLocation(prog, 'uRes'),
            time: gl.getUniformLocation(prog, 'uTime'),
            mouse: gl.getUniformLocation(prog, 'uMouse'),
            pix: gl.getUniformLocation(prog, 'uPix'),
            steps: gl.getUniformLocation(prog, 'uSteps'),
            shift: gl.getUniformLocation(prog, 'uShift'),
            zoom: gl.getUniformLocation(prog, 'uZoom'),
            fault: gl.getUniformLocation(prog, 'uFault'),
            neg: gl.getUniformLocation(prog, 'uNeg'),
          };
          return true;
        };

        if (!build()) {
          canvas.classList.add('dead');
          return;
        }

        // A driver reset or a long spell in the background can take the context
        // away. Without this the page would stay blank for good.
        canvas.addEventListener('webglcontextlost', (e) => {
          e.preventDefault();
          running = false;
        });

        canvas.addEventListener('webglcontextrestored', () => {
          if (!build()) {
            canvas.classList.add('dead');
            return;
          }
          canvas.width = 0; // force resize() to reset the viewport
          running = true;
          last = performance.now();
          requestAnimationFrame(frame);
        });

        const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const coarse = window.matchMedia('(pointer: coarse)').matches;

        const state = {
          scale: coarse ? 0.75 : 1,
          steps: coarse ? 64 : 88,
          target: [0, 0],
          smooth: [0, 0],
          cell: 2,
        };

        const dpr = () => Math.min(window.devicePixelRatio || 1, 1.75);

        const resize = () => {
          const d = dpr() * state.scale;
          const w = Math.max(1, Math.round(window.innerWidth * d));
          const h = Math.max(1, Math.round(window.innerHeight * d));
          if (canvas.width !== w || canvas.height !== h) {
            canvas.width = w;
            canvas.height = h;
            gl.viewport(0, 0, w, h);
          }
          state.cell = Math.max(1.5, Math.round(2 * d * 10) / 10);
        };

        window.addEventListener('resize', resize, { passive: true });
        resize();

        // Reduced-motion visitors get the same tracking at a third the reach.
        const reach = calm ? 0.35 : 1;

        const point = (x, y) => {
          state.target[0] = ((x / window.innerWidth) * 2 - 1) * reach;
          state.target[1] = (1 - (y / window.innerHeight) * 2) * reach;
        };

        window.addEventListener(
          'pointermove',
          (e) => point(e.clientX, e.clientY),
          { passive: true }
        );

        let frames = 0;
        let acc = 0;
        let last = performance.now();
        let clock = 0;
        let running = true;

        // The shape turns at 0.075 rad/s, so drawing faster than 60fps buys
        // nothing visible and costs a 120Hz display twice the GPU for it.
        const TARGET = calm ? 1000 / 30 : 1000 / 60;
        let due = 0;

        document.addEventListener('visibilitychange', () => {
          running = !document.hidden;
          if (running) {
            last = performance.now();
            requestAnimationFrame(frame);
          }
        });

        function frame(now) {
          if (!running) return;
          requestAnimationFrame(frame);

          // Hold the cadence on the target grid without chasing a backlog.
          // The 1ms grace keeps a 60Hz display from losing a frame to drift.
          if (now + 1 < due) return;
          due = Math.max(now + TARGET * 0.5, due + TARGET);

          const dt = Math.min((now - last) / 1000, 0.1);
          last = now;
          clock += calm ? dt * 0.12 : dt;

          // Exponential chase, so the feel holds at 30fps and at 60fps alike.
          // 7/s covers most of the gap in a fifth of a second: it follows the
          // cursor closely without snapping rigidly to it.
          const follow = 1 - Math.exp(-(calm ? 3 : 7) * dt);
          state.smooth[0] += (state.target[0] - state.smooth[0]) * follow;
          state.smooth[1] += (state.target[1] - state.smooth[1]) * follow;

          resize();
          gl.uniform2f(u.res, canvas.width, canvas.height);
          gl.uniform1f(u.time, clock);
          gl.uniform2f(u.mouse, state.smooth[0], state.smooth[1]);
          gl.uniform1f(u.pix, state.cell);
          gl.uniform1f(u.steps, state.steps);
          const wide = window.innerWidth / window.innerHeight > 1.0;
          gl.uniform2f(u.shift, wide ? 0.54 : 0, wide ? -0.02 : 0.42);
          gl.uniform1f(u.zoom, wide ? 1 : 1.5);
          gl.uniform1f(u.fault, fault);
          gl.uniform1f(u.neg, neg);
          gl.drawArrays(gl.TRIANGLES, 0, 3);

          // Adaptive quality: trade resolution before frame rate.
          frames++;
          acc += dt;
          if (acc >= 1) {
            const fps = frames / acc;
            if (fps < 45 && state.scale > 0.55) {
              state.scale = Math.max(0.55, state.scale - 0.12);
            } else if (fps > 57 && state.scale < 1) {
              state.scale = Math.min(1, state.scale + 0.06);
            }
            frames = 0;
            acc = 0;
          }
        }

        requestAnimationFrame(frame);
      })();
    </script>
  </body>
</html>
